# API server (default 3001). Vite dev proxies /api here.
API_PORT=3001

# Bluesky (AT Protocol) — create an App Password in the Bluesky app.
BLUESKY_HANDLE=your.handle.bsky.social
BLUESKY_APP_PASSWORD=
# Optional custom PDS/service URL:
# BLUESKY_SERVICE=https://bsky.social

# LinkedIn — personal profile UGC. Tokens are manual in v1 (rotate in developer portal).
# Person URN looks like urn:li:person:XXXXXXXX
LINKEDIN_PERSON_URN=
LINKEDIN_ACCESS_TOKEN=
